pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'git@github.com:Zhantemirberikov/devops-final-project.git'.
 credentialsId: 'github-zhantemir-ssh'

            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -f Dockerfile_ZhantemirB -t devopsapp:zhantemir .'
            }
        }

        stage('Deploy') {
            steps {
                sh 'docker compose -f docker-compose_ZhantemirB.yml up -d'
            }
        }
    }
}
