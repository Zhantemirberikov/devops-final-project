pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                dir('app') {
                    sh 'chmod +x mvnw'
                    retry(3) {
                        sh './mvnw clean package -DskipTests'
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('app') {
                    sh 'docker build -f Dockerfile_ZhantemirB -t devopsapp:zhantemir .'
                }
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                ssh -o StrictHostKeyChecking=no devops@192.168.68.58 "
                    cd /opt/devops-project/app &&
                    docker compose -f docker-compose_ZhantemirB.yml up -d
                "
                '''
            }
        }
    }
}
