pipeline {
    agent any

    environment {
        APP_NAME = "todo-app"
        IMAGE = "zhantemirb/todo-app"
        VERSION = "${env.BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    credentialsId: 'git-cred',
                    url: 'https://github.com/Zhantemirberikov/devops-final-project.git'
            }
        }

        stage('Build') {
            steps {
                dir('app') {
                    sh 'chmod +x mvnw'
                    sh './mvnw clean package -DskipTests'
                }
            }
        }

        stage('Test') {
            steps {
                dir('app') {
                    sh './mvnw test'
                }
            }
        }

        stage('Static Analysis') {
            steps {
                echo "Static analysis (placeholder: Checkstyle / SpotBugs)"
            }
        }

        stage('Docker Build') {
            steps {
                dir('app') {
                    sh """
                        docker build -f Dockerfile_ZhantemirB -t ${IMAGE}:${VERSION} .
                    """
                }
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([usernamePassword(
                        credentialsId: 'docker-cred',
                        usernameVariable: 'USER',
                        passwordVariable: 'PASS'
                )]) {
                    sh """
                        echo $PASS | docker login -u $USER --password-stdin
                        docker push ${IMAGE}:${VERSION}
                    """
                }
            }
        }

        stage('Deploy to Production') {
            when {
                branch "main"
            }
            steps {
                echo "Kubernetes deployment happens in Part 3"
            }
        }
    }

    post {
        success {
            archiveArtifacts artifacts: 'app/target/*.jar', fingerprint: true
            echo "Build successful!"
        }
        failure {
            echo "Pipeline failed!"
        }
    }
}
