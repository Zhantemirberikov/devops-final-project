pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                dir('app') {
                    sh 'ls -la'
                    sh 'chmod +x mvnw'
                    retry(3) {
                        sh './mvnw clean package -DskipTests'
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('app') {
                    sh 'docker build -f Dockerfile_ZhantemirB -t devopsapp:zhantemir .'
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('app') {
                    sh 'docker-compose -f docker-compose_ZhantemirB.yml up -d'
                }
            }
        }
    }
}
